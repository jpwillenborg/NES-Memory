@model IEnumerable<NES_Box_Art.Models.TimelineGameViewModel>
@using IGDB

@{
    ViewData["Title"] = "Cartridge Size Analytics Timeline";
}

<div class="container my-5">
    <div class="text-center mb-5">
        <h1 class="display-4 font-weight-bold text-dark">NES Hardware Optimization Timeline</h1>
        <p class="lead text-muted">
            Visualizing how 8-bit game developers optimized storage limits over time—from <strong>24 KB</strong> up to <strong>768 KB</strong>.
        </p>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm mt-2">← Back to Main Gallery</a>
    </div>

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger">@ViewBag.Error</div>
    }

    <!-- The Vertical Timeline Rail -->
    <div class="position-relative border-start border-3 border-danger ps-4 ms-3 mt-4">
        
        @foreach (var item in Model)
        {
            var imageId = item.IgdbData.Cover?.Value?.ImageId;
            var imageUrl = !string.IsNullOrEmpty(imageId) 
                ? IGDB.ImageHelper.GetImageUrl(imageId, ImageSize.CoverBig, false).Replace("//", "https://") 
                : "";

            <!-- Individual Timeline Event Node -->
            <div class="mb-5 position-relative">
                
                <!-- Timeline Dot Indicator -->
                <div class="position-absolute bg-danger rounded-circle" 
                     style="width: 20px; height: 20px; left: -34px; top: 12px; border: 4px solid white;"></div>

                <div class="card shadow-sm border-0 overflow-hidden">
                    <div class="row g-0">
                        
                        <!-- Visual Art Display Column -->
                        <div class="col-md-2 bg-light d-flex align-items-center justify-content-center p-3">
                            @if (!string.IsNullOrEmpty(imageUrl))
                            {
                                <img src="@imageUrl" class="img-fluid rounded" alt="@item.IgdbData.Name Box Art" style="max-height: 140px; object-fit: contain;">
                            }
                        </div>

                        <!-- Data Analytics Summary Column -->
                        <div class="col-md-10">
                            <div class="card-body">
                                <div class="d-flex justify-content-between align-items-start flex-wrap">
                                    <div>
                                        <span class="badge bg-danger text-uppercase mb-1">@item.ReleaseYear</span>
                                        <h4 class="card-title text-dark mb-1">@item.IgdbData.Name</h4>
                                    </div>
                                    <div class="text-md-end mt-2 mt-md-0">
                                        <h3 class="text-danger font-weight-bold m-0">@item.SizeInKb <small class="text-muted fs-6">KB</small></h3>
                                        <span class="badge bg-dark">Chipset: @item.MapperChip</span>
                                    </div>
                                </div>

                                <!-- Dynamic Storage Analytics Progress Visualization Bar -->
                                <div class="mt-3">
                                    <div class="d-flex justify-content-between small text-muted mb-1">
                                        <span>Cartridge Data Density Allocation</span>
                                        <span>@item.VisualPercentage% Capacity utilized relative to absolute console limits</span>
                                    </div>
                                    <div class="progress" style="height: 12px;">
                                        <div class="progress-bar bg-danger progress-bar-striped progress-bar-animated" 
                                             role="progressbar" 
                                             style="width: @item.VisualPercentage%;" 
                                             aria-valuenow="@item.VisualPercentage" 
                                             aria-valuemin="0" 
                                             aria-valuemax="100"></div>
                                    </div>
                                </div>

                            </div>
                        </div>

                    </div>
                </div>

            </div>
        }
    </div>
</div>
