@model IEnumerable<NES_Box_Art.Models.TimelineGameViewModel>
@using IGDB

@{
    ViewData["Title"] = "NES Game Memory Comparison";
}

<!-- Loads the Poppins font family weights natively from Google Fonts -->
<link rel="preconnect" href="https://googleapis.com">
<link rel="preconnect" href="https://gstatic.com" crossorigin>
<link href="https://googleapis.com/css2?family=Poppins:wght@400;500;600;700;800&display=swap" rel="stylesheet">

<style>
    /* MASTER THEME CONTROL MATRIX: Edit color codes once in this block to change them everywhere */
    :root {
        --color-theme-a: #E31B23;       /* GAME A: Clear Crimson Red */
        --color-theme-b: #8B0000;       /* GAME B: Deep Maroon */
        --color-readout: #FFC107;       /* READOUTS: System Amber Yellow */
        --color-panel-bg: #2b3035;      /* PANELS: Lighter Gray Card Background */
        --color-page-bg: #1a1d20;       /* PAGE CANVAS: Main Background Canvas */
        --color-scrollbar: #555a60;     /* SCROLLBAR: Independent list scrollbar thumb */
        --color-reset-btn: #495057;     /* RESET BUTTON: Independent style color parameter */
    }

    body {
        margin: 0;
        background-color: var(--color-page-bg) !important;
        color: #dee2e6;
    }

    body, :not(.font-monospace):not(small):not(.slot-indicator):not(.badge) {
        font-family: 'Poppins', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif !important;
    }

    #pixel-matrix-rail {
        display: grid;
        grid-template-columns: repeat(29, 1fr); 
        gap: 6px; 
        background-color: #000000;
        padding: 20px;
        border-radius: 8px;
    }

    #payload-pool-wrapper {
        /* FIXED: Lowered max-height from 888px to 886px to perfectly trim the baseline footprint */
        max-height: 886px; 
        overflow-y: auto;
        padding-right: 4px; 
    }

    #payload-pool-wrapper::-webkit-scrollbar {
        width: 6px;
    }
    #payload-pool-wrapper::-webkit-scrollbar-track {
        background: #111111;
        border-radius: 4px;
    }
    #payload-pool-wrapper::-webkit-scrollbar-thumb {
        background: var(--color-scrollbar); 
        border-radius: 4px;
    }
    #payload-pool-wrapper::-webkit-scrollbar-thumb:hover {
        background: var(--color-theme-a); 
        border-radius: 4px;
    }

    .memory-cell {
        aspect-ratio: 1 / 1; 
        background-color: rgba(255, 255, 255, 0.08); 
        border: 1px solid rgba(255, 255, 255, 0.02);
        border-radius: 2px;
        transition: background-color 0.2s ease, box-shadow 0.2s ease;
    }

    .memory-cell.slot-a-color { background-color: var(--color-theme-a) !important; }
    .memory-cell.slot-b-color { background-color: var(--color-theme-b) !important; }










    
    
    
    
        .card, .list-group-item.game-select-btn, .bg-body-tertiary {
        background-color: var(--color-panel-bg) !important;
        border-top: none !important;
        border-right: none !important;
        border-bottom: none !important;
        border-left: none; 
    }
    
    .badge.bg-black {
        border: none !important;
    }
    
    .game-select-btn {
        transition: transform 0.15s ease-in-out, box-shadow 0.15s ease-in-out;
        cursor: pointer;
    }
    .game-select-btn:hover {
        transform: translateX(4px);
    }
    
    .border-slot-a { border-left: 6px solid var(--color-theme-a) !important; }
    .border-slot-b { border-left: 6px solid var(--color-theme-b) !important; }
    
    .slot-art-frame {
        width: 85px;
        max-height: 115px; 
        object-fit: contain; 
        background: transparent !important;
        border: none !important;
        filter: drop-shadow(0px 4px 6px rgba(0, 0, 0, 0.6)); 
    }
    .sidebar-art-frame {
        width: 70px;
        max-height: 95px; 
        object-fit: contain; 
        background: transparent !important;
        border: none !important;
        filter: drop-shadow(0px 3px 5px rgba(0, 0, 0, 0.6));
    }

    .retro-select {
        background-color: var(--color-page-bg) !important;
        border: 1px solid #2d3238 !important;
        color: #dee2e6 !important;
    }
    .retro-select:focus {
        border-color: var(--color-theme-a) !important;
        box-shadow: 0 0 0 0.25rem rgba(227, 27, 35, 0.25) !important;
    }

    @Html.Raw("@media (max-width: 767.98px) {")
        .container-fluid { padding-left: 10px !important; padding-right: 10px !important; }
        #payload-pool-wrapper { max-height: none !important; overflow-y: visible !important; padding-right: 0 !important; }
        .sidebar-art-frame { width: 50px; max-height: 70px; }
        .game-select-btn { padding: 10px !important; }
        .item-title { font-size: 0.95rem !important; }
        #pixel-matrix-rail { grid-template-columns: repeat(24, 1fr); gap: 2px; padding: 8px !important; max-height: none !important; }
        .memory-cell { width: auto; height: auto; aspect-ratio: 1 / 1; }
        .col-lg-4.col-md-5 { margin-top: calc(1.5rem + 6px) !important; }
    @Html.Raw("}")
</style>













    <div class="container-fluid my-4 px-md-5">
    <div class="text-center mb-4">
        <h1 class="display-5 fw-bold text-light fs-2 fs-md-1 mb-4">NES System Bus & Memory Allocation Matrix</h1>
        
        <!-- FIXED: Adjusted font-size inline parameter up to a balanced 1.05rem -->
        <p class="text-muted mb-4" style="max-width: 900px; margin-right: auto; margin-left: auto; font-size: 1.05rem; line-height: 1.6;">
            Standard NES hardware was originally restricted to a small 64KB address space boundary - until custom Memory Management Controllers (MMCs) or Mappers were introduced. This tool helps visualize how mappers expanded the boundaries to house larger game maps and complex audio.
        </p>
        
        <!-- FIXED: Applied the same 1.05rem balance to the second paragraph to keep text blocks matching -->
        <p class="text-muted mb-5" style="max-width: 900px; margin-right: auto; margin-left: auto; font-size: 1.05rem; line-height: 1.6;">
            Select two games from the list to see how 
            <span style="color: var(--color-theme-a); font-weight: bold;">CARTRIDGE A</span> and 
            <span style="color: var(--color-theme-b); font-weight: bold;">CARTRIDGE B</span> compare in terms of memory footprint.
        </p>
    </div>

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger bg-dark border-danger text-danger font-monospace text-center mb-4 shadow-sm" role="alert">
            <h5 class="alert-heading fw-bold">⚠️ CONNECTION ERROR</h5>
            <p class="mb-0 small">@ViewBag.Error</p>
        </div>
    }

    <div class="row flex-column-reverse flex-md-row" style="--bs-gutter-x: calc(1rem + 14px) !important;">
        <!-- LEFT COLUMN: SIDEBAR LIST VIEWS -->
        <div class="col-lg-4 col-md-5">
            <div class="card p-3 bg-dark border border-secondary border-opacity-25 rounded shadow-sm" style="margin-bottom: calc(1.5rem + 6px) !important;">
                <label for="retro-sort-dropdown" class="form-label text-muted small text-uppercase mb-2">Bus Matrix Sorting Engine</label>
                <div class="d-flex gap-2">
                    <select id="retro-sort-dropdown" class="form-select form-select-sm retro-select">
                        <option value="release">Release Date (Oldest)</option>
                        <option value="release-desc">Release Date (Newest)</option>
                        <option value="alpha">Alphabetical (A-Z)</option>
                        <option value="size-asc">Memory Size (Smallest)</option>
                        <option value="size-desc">Memory Size (Largest)</option>
                        <option value="chip">Memory Chip Type</option>
                    </select>
                    <button type="button" id="clear-selection-btn" class="btn btn-sm text-white" style="background-color: var(--color-reset-btn); border: 1px solid rgba(0,0,0,0.1);" title="Reset Slots">Reset</button>
                </div>
            </div>
            
            <div class="list-group shadow-sm rounded border-0" id="payload-pool-wrapper">
                @if (Model != null && Model.Any())
                {
                    @foreach (var item in Model)
                    {
                        var imageId = item.IgdbData.Cover?.Value?.ImageId;
                        var imageUrl = !string.IsNullOrEmpty(imageId) 
                            ? IGDB.ImageHelper.GetImageUrl(imageId, ImageSize.CoverBig, false).Replace("//", "https://") 
                            : "https://placehold.co";

                        <div class="list-group-item list-group-item-action p-3 game-select-btn mb-1 rounded bg-dark text-white shadow-sm"
                             data-size="@item.SizeInKb"
                             data-name="@item.IgdbData.Name"
                             data-chip="@item.MapperChip"
                             data-year="@item.ReleaseYear"
                             data-img="@imageUrl">
                            <div class="d-flex align-items-center gap-2 gap-sm-3">
                                <img src="@imageUrl" alt="" class="rounded sidebar-art-frame">
                                <div class="flex-grow-1 overflow-hidden">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <h6 class="mb-0 fw-bold item-title text-truncate">@item.IgdbData.Name</h6>
                                        <span class="badge bg-secondary opacity-75 ms-1">@item.SizeInKb K</span>
                                    </div>
                                    <div class="d-flex justify-content-between align-items-center mt-2">
                                        <small class="text-muted text-truncate small">@item.MapperChip | @item.ReleaseYear</small>
                                        <span class="slot-indicator badge bg-dark text-muted small">Idle</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="text-center p-4 text-muted border border-secondary border-opacity-25 rounded bg-dark small shadow-sm">
                        --- No Games Found ---
                    </div>
                }
            </div>
        </div>















                <!-- RIGHT COLUMN: CHOSEN SLOTS AND VISUAL MATRIX GRID -->
        <div class="col-lg-8 col-md-7">
            <div class="row g-3 mb-4 pb-2" style="--bs-gutter-x: calc(1.5rem + 6px) !important;">
                <!-- Slot A Dashboard -->
                <div class="col-12 col-md-6">
                    <div class="card p-3 bg-dark rounded border-start border-4 border-slot-a shadow-sm" style="min-height: 135px; border-top:none; border-right:none; border-bottom:none;">
                        <div class="d-flex align-items-center gap-3 h-100">
                            <img src="https://placehold.co" id="slot-a-img" class="rounded slot-art-frame d-none" alt="">
                            <div class="flex-grow-1 overflow-hidden">
                                <span class="small d-block text-uppercase" style="color: var(--color-theme-a) !important; font-weight: 500;">[ CARTRIDGE A ]</span>
                                <h5 class="m-0 text-white text-truncate mt-1" id="slot-a-title">--- Empty ---</h5>
                                <small class="text-muted d-block mt-1" id="slot-a-meta">Select a game on the left</small>
                            </div>
                        </div>
                    </div>
                </div>
                <!-- Slot B Dashboard -->
                <div class="col-12 col-md-6">
                    <div class="card p-3 bg-dark rounded border-start border-4 border-slot-b shadow-sm" style="min-height: 135px; border-top:none; border-right:none; border-bottom:none;">
                        <div class="d-flex align-items-center gap-3 h-100">
                            <img src="https://placehold.co" id="slot-b-img" class="rounded slot-art-frame d-none" alt="">
                            <div class="flex-grow-1 overflow-hidden">
                                <span class="small d-block text-uppercase" style="color: var(--color-theme-b) !important; font-weight: 500;">[ CARTRIDGE B ]</span>
                                <h5 class="m-0 text-white text-truncate mt-1" id="slot-b-title">--- Empty ---</h5>
                                <small class="text-muted d-block mt-1" id="slot-b-meta">Select a game on the left</small>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card p-3 p-md-4 shadow-sm bg-body-tertiary">
                <div class="d-flex justify-content-between align-items-center mb-3 w-100 flex-wrap gap-2">
                    <h5 class="m-0 text-muted fs-6 fs-md-5">Visual Size Comparison (in KB)</h5>
                    <!-- FIXED: Removed text-white and applied custom color directly to the parent badge wrapper -->
                    <div class="badge bg-black px-3 py-2 small" style="color: var(--color-readout); font-weight: bold;">
                        Difference: <span id="live-difference-readout">0 KB</span>
                    </div>
                </div>

                <div id="pixel-matrix-rail">
                    @for (int i = 1; i <= 768; i++)
                    {
                        <div class="memory-cell" id="cell-@i" data-index="@i"></div>
                    }
                </div>
                
                <div class="row mt-3 pt-2 border-top border-secondary border-opacity-25 text-center g-2 small w-100 mx-0">
                    <div class="col-4 text-start text-truncate"><span class="d-inline-block rounded-1 me-1" style="width:10px; height:10px; background:rgba(255,255,255,0.08);"></span> <span class="text-muted">Empty</span></div>
                    <div class="col-4 text-start text-truncate"><span class="d-inline-block rounded-1 me-1" style="width:10px; height:10px; background: var(--color-theme-a);"></span> <span style="color: var(--color-theme-a);">Game A</span></div>
                    <div class="col-4 text-start text-truncate"><span class="d-inline-block rounded-1 me-1" style="width:10px; height:10px; background: var(--color-theme-b);"></span> <span style="color: var(--color-theme-b);">Game B</span></div>
                </div>
            </div>
        </div>
    </div>
</div>









<script>
    document.addEventListener("DOMContentLoaded", function () {
        var wrapper = document.getElementById("payload-pool-wrapper");
        var clearBtn = document.getElementById("clear-selection-btn");
        var sortDropdown = document.getElementById("retro-sort-dropdown");
        var diffReadout = document.getElementById("live-difference-readout");
        var cells = document.querySelectorAll(".memory-cell");

        var slotA = null;
        var slotB = null;

        // Event delegation handles dynamic list clicks safely across sorting updates
        if (wrapper) {
            wrapper.addEventListener("click", function (e) {
                var btn = e.target.closest(".game-select-btn");
                if (!btn) return;

                var name = btn.getAttribute("data-name");
                var size = parseInt(btn.getAttribute("data-size")) || 0;
                var chip = btn.getAttribute("data-chip");
                var year = btn.getAttribute("data-year");
                var img = btn.getAttribute("data-img");
                var currentData = { name: name, size: size, chip: chip, year: year, img: img, element: btn };

                if (slotA && slotA.name === name) { 
                    slotA = null; 
                    clearButtonState(btn); 
                } 
                else if (slotB && slotB.name === name) { 
                    slotB = null; 
                    clearButtonState(btn); 
                } 
                else if (!slotA) { 
                    slotA = currentData; 
                    setButtonState(btn, "A", "var(--color-theme-a)", "border-slot-a"); 
                } 
                else if (!slotB) { 
                    slotB = currentData; 
                    setButtonState(btn, "B", "var(--color-theme-b)", "border-slot-b"); 
                } 
                else {
                    clearButtonState(slotA.element); 
                    slotA = slotB;
                    setButtonState(slotA.element, "A", "var(--color-theme-a)", "border-slot-a");
                    slotB = currentData; 
                    setButtonState(btn, "B", "var(--color-theme-b)", "border-slot-b");
                }
                updateDashboards(); 
                renderMapMatrix();
            });
        }

        sortDropdown.addEventListener("change", function () {
            var items = Array.from(wrapper.querySelectorAll(".game-select-btn"));
            if(!items.length) return;
            var sortCriteria = this.value;

            items.sort(function (a, b) {
                var nameA = a.getAttribute("data-name") || "";
                var nameB = b.getAttribute("data-name") || "";

                if (sortCriteria === "release") {
                    var yearA = parseInt(a.getAttribute("data-year")) || 0;
                    var yearB = parseInt(b.getAttribute("data-year")) || 0;
                    if (yearA === yearB) return nameA.localeCompare(nameB);
                    return yearA - yearB;
                } 
                else if (sortCriteria === "release-desc") {
                    var yearA = parseInt(a.getAttribute("data-year")) || 0;
                    var yearB = parseInt(b.getAttribute("data-year")) || 0;
                    if (yearA === yearB) return nameB.localeCompare(nameA);
                    return yearB - yearA;
                }
                else if (sortCriteria === "alpha") {
                    return nameA.toLowerCase().localeCompare(nameB.toLowerCase());
                } 
                else if (sortCriteria === "size-desc") {
                    var sizeA = parseInt(a.getAttribute("data-size")) || 0;
                    var sizeB = parseInt(b.getAttribute("data-size")) || 0;
                    if (sizeA === sizeB) return nameA.localeCompare(nameB);
                    return sizeB - sizeA;
                } 
                else if (sortCriteria === "size-asc") {
                    var sizeA = parseInt(a.getAttribute("data-size")) || 0;
                    var sizeB = parseInt(b.getAttribute("data-size")) || 0;
                    if (sizeA === sizeB) return nameA.localeCompare(nameB);
                    return sizeA - sizeB;
                } 
                else if (sortCriteria === "chip") {
                    var chipA = (a.getAttribute("data-chip") || "").toLowerCase();
                    var chipB = (b.getAttribute("data-chip") || "").toLowerCase();
                    if (chipA === chipB) return nameA.localeCompare(nameB);
                    return chipA.localeCompare(chipB);
                }
                return 0;
            });

            items.forEach(function (item) { wrapper.appendChild(item); });
            if (slotA) { var foundA = items.find(function(i) { return i.getAttribute("data-name") === slotA.name; }); if (foundA) slotA.element = foundA; }
            if (slotB) { var foundB = items.find(function(i) { return i.getAttribute("data-name") === slotB.name; }); if (foundB) slotB.element = foundB; }
        });

        clearBtn.addEventListener("click", function() {
            if(slotA) clearButtonState(slotA.element); 
            if(slotB) clearButtonState(slotB.element);
            slotA = null; 
            slotB = null;
            var items = wrapper.querySelectorAll(".game-select-btn");
            items.forEach(function (item) { item.style.removeProperty("display"); });
            updateDashboards(); 
            renderMapMatrix();
        });


        
                function setButtonState(el, slotLabel, themeVar, borderClass) {
            if (!el) return;
            el.className = "list-group-item list-group-item-action p-3 game-select-btn mb-1 rounded text-white shadow-sm " + borderClass;
            el.style.backgroundColor = themeVar;
            var indicator = el.querySelector(".slot-indicator");
            if (indicator) {
                indicator.innerText = "Cartridge " + slotLabel;
                indicator.classList.replace("bg-dark", "bg-white"); 
                indicator.classList.replace("text-muted", "text-black");
            }
        }

        function clearButtonState(el) {
            if (!el) return;
            el.className = "list-group-item list-group-item-action p-3 game-select-btn mb-1 rounded bg-dark text-white shadow-sm";
            el.style.removeProperty("background-color");
            var indicator = el.querySelector(".slot-indicator");
            if (indicator) {
                indicator.innerText = "Idle";
                indicator.className = "slot-indicator badge bg-dark text-muted font-monospace small";
            }
        }

        function updateDashboards() {
            var titleA = document.getElementById("slot-a-title"), metaA = document.getElementById("slot-a-meta"), imgA = document.getElementById("slot-a-img");
            if (slotA) { 
                titleA.innerText = slotA.name; 
                metaA.innerText = slotA.size + " KB | " + slotA.chip + " | " + slotA.year; 
                imgA.src = slotA.img; 
                imgA.classList.remove("d-none"); 
            } 
            else { 
                titleA.innerText = "--- Empty ---"; 
                metaA.innerText = "Select a game on the left"; 
                imgA.classList.add("d-none"); 
                imgA.src = ""; 
            }

            var titleB = document.getElementById("slot-b-title"), metaB = document.getElementById("slot-b-meta"), imgB = document.getElementById("slot-b-img");
            if (slotB) { 
                titleB.innerText = slotB.name; 
                metaB.innerText = slotB.size + " KB | " + slotB.chip + " | " + slotB.year; 
                imgB.src = slotB.img; 
                imgB.classList.remove("d-none"); 
            } 
            else { 
                titleB.innerText = "--- Empty ---"; 
                metaB.innerText = "Select a game on the left"; 
                imgB.classList.add("d-none"); 
                imgB.src = ""; 
            }
        }

        function renderMapMatrix() {
            var sizeA = slotA ? slotA.size : 0, sizeB = slotB ? slotB.size : 0, deltaSize = Math.abs(sizeA - sizeB);
            
            // FIXED: Pure text representation since the parent element controls the matching color style uniformly
            var textReadout = "A: " + sizeA + "K | B: " + sizeB + "K (" + deltaSize + "K Difference)";
            var altReadout = Math.max(sizeA, sizeB) + " KB Loaded";
            
            if (diffReadout) {
                diffReadout.innerHTML = (sizeA > 0 && sizeB > 0) ? textReadout : (sizeA > 0 || sizeB > 0) ? altReadout : "0 KB";
            }
            
            cells.forEach(function (cell) {
                var idx = parseInt(cell.getAttribute("data-index")); 
                cell.classList.remove("slot-a-color", "slot-b-color");
                var trackingA = (idx <= sizeA), trackingB = (idx <= sizeB);
                if (trackingA && trackingB) { 
                    cell.classList.add(sizeA <= sizeB ? "slot-a-color" : "slot-b-color"); 
                } 
                else if (trackingA) { 
                    cell.classList.add("slot-a-color"); 
                } 
                else if (trackingB) { 
                    cell.classList.add("slot-b-color"); 
                }
            });
        }
    });
</script>