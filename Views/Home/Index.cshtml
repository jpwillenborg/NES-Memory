@model IEnumerable<IGDB.Models.Game>
@using IGDB

@{
    ViewData["Title"] = "NES Box Art Gallery";
}

<div class="text-center my-4">
    <h1 class="display-4 font-weight-bold text-danger">NES Box Art Gallery</h1>
    <p class="lead">Displaying vintage Nintendo Entertainment System covers directly from the IGDB API.</p>
</div>

<!-- --- NEW SEARCH BAR FORM --- -->
<div class="row justify-content-center mb-5">
    <div class="col-md-6">
        <form asp-action="Index" method="get" class="d-flex shadow-sm rounded">
            <input type="text" 
                   name="searchTerm" 
                   class="form-control form-control-lg border-danger" 
                   placeholder="Search for an NES game (e.g., Mario, Zelda, Metroid)..." 
                   value="@ViewBag.SearchTerm" />
            <button type="submit" class="btn btn-danger btn-lg px-4">Search</button>
        </form>
        @if (!string.IsNullOrEmpty(ViewBag.SearchTerm))
        {
            <div class="text-center mt-2">
                <a asp-action="Index" class="text-secondary text-decoration-none small">Clear Search Results</a>
            </div>
        }
    </div>
</div>
<!-- -------------------------- -->

@if (ViewBag.Error != null)
{
    <div class="alert alert-danger" role="alert">
        @ViewBag.Error
    </div>
}

@if (!Model.Any())
{
    <div class="text-center my-5">
        <h4 class="text-muted">No NES box art found matching "@ViewBag.SearchTerm".</h4>
    </div>
}

<div class="row row-cols-1 row-cols-md-3 row-cols-lg-5 g-4">
    @foreach (var game in Model)
    {
        // 1. Check if the cover relationship exists
        // 2. Extract the actual Image ID string from the wrapper value
        var imageId = game.Cover?.Value?.ImageId;

        if (!string.IsNullOrEmpty(imageId))
        {
            // Use the SDK's built-in ImageHelper to generate a secure, high-res URL
            var imageUrl = IGDB.ImageHelper.GetImageUrl(
                imageId: imageId, 
                size: ImageSize.CoverBig, 
                retina: false
            );

            // Ensure the URL has the correct security protocol prepended
            if (imageUrl.StartsWith("//"))
            {
                imageUrl = "https:" + imageUrl;
            }

            <div class="col">
                <div class="card h-100 shadow-sm border-0">
                    <img src="@imageUrl" class="card-img-top p-2" alt="@game.Name Box Art" style="object-fit: contain; max-height: 250px;">
                    <div class="card-body d-flex flex-column justify-content-end bg-light">
                        <h6 class="card-title text-center text-dark m-0">@game.Name</h6>
                    </div>
                </div>
            </div>
        }
    }
</div>
